{
  "name": "finances",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx scripts/seed.ts",
    "db:import": "tsx scripts/import-expenses.ts",
    "db:demo": "tsx scripts/demo-data.ts",
    "desktop:dev": "MAVIE_URL=${MAVIE_URL:-http://127.0.0.1:3000} electron .",
    "desktop:build": "bash scripts/build-mac.sh",
    "desktop:smoke": "node scripts/smoke-mac.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "@electron/rebuild": "^4.0.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.rayanerrr.mavie",
    "productName": "MaVie",
    "artifactName": "MaVie-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "files": [
      "desktop/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*",
          "!data/**"
        ]
      },
      {
        "from": "public/logo.svg",
        "to": "logo.svg"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.finance",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "desktop/after-pack.cjs"
  }
}
